generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Prediction {
  id                Int      @id @default(autoincrement())
  vehicleCategory   String   @map("vehicle_category")
  vehicleType       String   @map("vehicle_type")
  engineCc          Float    @map("engine_cc")
  cylinders         Int
  horsepower        Float
  weightKg          Float    @map("weight_kg")
  transmission      String
  fuelType          String   @map("fuel_type")
  coolingSystem     String?  @map("cooling_system")
  dailyDistanceKm   Float    @map("daily_distance_km")
  dailyIncome       Float?   @map("daily_income")
  fuelPricePerLiter Float?   @map("fuel_price_per_liter")
  year              Int
  predictedKmpl     Float    @map("predicted_kmpl")
  label             String
  threshold         Float
  fuelCostPerKm     Float?   @map("fuel_cost_per_km")
  incomePerKm       Float?   @map("income_per_km")
  fuelCostRatio     Float?   @map("fuel_cost_ratio")
  dailyProfit       Float?   @map("daily_profit")
  shapValues        Json?    @map("shap_values")
  baseValue         Float?   @map("base_value")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("predictions")
}
